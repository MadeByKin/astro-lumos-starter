---
interface Props {
  /** Playback control. */
  control: "playpause" | "mute" | "fullscreen";
  /** Accessible label. */
  label: string;
}
const { control, label } = Astro.props;
const paths = {
  playpause: ["M8 5v14l11-7Z", "M8 5v14M16 5v14"],
  mute: [
    "M3 9v6h4l5 4V5L7 9Zm13-1c3 2 3 6 0 8",
    "M3 9v6h4l5 4V5L7 9Zm13 1 5 5m0-5-5 5",
  ],
  fullscreen: [
    "M9 3H3v6m12-6h6v6M3 15v6h6m12-6v6h-6",
    "M3 9h6V3m6 0v6h6M9 21v-6H3m18 0h-6v6",
  ],
};
---

<button
  type="button"
  class="bunny-button_wrap"
  data-player-control={control}
  aria-label={label}
>
  {paths[control].map((path, index) => (
    <svg
      data-player-icon={index === 0 ? "primary" : "alternate"}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={path} />
    </svg>
  ))}
</button>
<style is:global>
  @layer components {
    .bunny-button_wrap {
      display: grid;
      place-items: center;
      flex: 0 0 auto;
      width: 2.75rem;
      height: 2.75rem;
      padding: 0.75rem;
      border: var(--border-width) solid
        color-mix(in srgb, currentColor 20%, transparent);
      border-radius: var(--radius-round);
      background: var(--dark-900);
      color: var(--light-100);
      cursor: pointer;
      transition: background var(--hover-duration) var(--hover-ease);
      &:hover {
        background: var(--dark-700);
      }
      &:focus-visible {
        outline: var(--focus-width) solid var(--brand-500);
        outline-offset: var(--focus-offset);
      }
      svg {
        width: 100%;
        height: 100%;
        grid-area: 1 / 1;
      }
      [data-player-icon="alternate"] {
        display: none;
      }
    }
    [data-player-status="playing"] [data-player-control="playpause"],
    [data-player-status="loading"] [data-player-control="playpause"],
    [data-player-muted="true"] [data-player-control="mute"],
    [data-player-fullscreen="true"] [data-player-control="fullscreen"] {
      [data-player-icon="primary"] {
        display: none;
      }
      [data-player-icon="alternate"] {
        display: block;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .bunny-button_wrap {
        transition: none;
      }
    }
  }
</style>
