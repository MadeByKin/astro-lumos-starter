---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Img from "@/components/media/Img.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import lumosBackground from "@/assets/graphics/lumos-background.svg";
---

<Layout title="Astro Lumos Starter" theme="dark">
  <Section paddingTop="even" paddingBottom="even">
    <ContentWrapper variant="card" class="theme-brand" mediaOpacity={100}>
      <Paragraph variant="small">ASTRO LUMOS STARTER</Paragraph>
      <Heading
        tag="h1"
        variant="display"
        maxWidth={14}
        data-reveal="up"
        data-reveal-distance="0.75"
      >
        A considered starting point.
      </Heading>
      <Paragraph variant="large" maxWidth={48}>
        Smooth scrolling, purposeful motion and an editable component system. A
        dependable foundation for your next client site.
      </Paragraph>
      <ButtonWrapper>
        <Button element="link" href="/example-components">
          Example components
        </Button>
      </ButtonWrapper>
      <Img
        slot="column2"
        src={lumosBackground}
        width={1920}
        height={1080}
        loading="eager"
        fetchPriority="high"
        alt=""
      />
    </ContentWrapper>
  </Section>
</Layout>
