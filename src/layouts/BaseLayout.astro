---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { fade, slide } from "astro:transitions";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import Nav from "@/components/global/Nav.astro";
import SiteRuntime from "@/components/utility/SiteRuntime.astro";
import Footer from "@/components/global/Footer.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark" | "brand";
  /**
   * Fix the nav over the page rather than letting it stick in flow, so the
   * first section starts underneath it. Give that section
   * `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
  /** Explicit animation for this page's main content. */
  pageTransition?: "fade" | "slide" | "none";
};

const {
  theme = "inherit",
  overlap = false,
  pageTransition = "fade",
  ...seo
} = Astro.props;
const animation =
  pageTransition === "slide"
    ? slide({ duration: "0.4s" })
    : pageTransition === "none"
      ? "none"
      : fade({ duration: "0.2s" });
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <SiteRuntime />
    <SkipLink />
    <Nav overlap={overlap} />
    <main
      id="main"
      tabindex="-1"
      data-page-transition={pageTransition}
      transition:name="page-content"
      transition:animate={animation}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
