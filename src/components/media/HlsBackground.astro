---
import type { HTMLAttributes } from "astro/types";
import HlsButton from "./HlsButton.astro";
interface Props extends Omit<HTMLAttributes<"div">, "src"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HLS playlist URL. Omit to render nothing. */
  src?: string;
  /** Poster image URL. */
  poster?: string;
  /** Accessible label. */
  label?: string;
  /** Start automatically when visible and motion is allowed. */
  autoplay?: boolean;
  /** Show play and pause controls. */
  controls?: boolean;
  /** Defer stream loading until playback is requested. */
  lazy?: boolean;
}
const {
  render = true,
  src,
  poster,
  label = "Background video",
  autoplay = true,
  controls = true,
  lazy = true,
  class: className,
  ...rest
} = Astro.props;
---

{render && src && (
  <hls-background style="display: contents">
    <div
      {...rest}
      class:list={["hls-background_wrap", className]}
      role="group"
      aria-label={label}
      data-hls-background-init
      data-player-src={src}
      data-player-autoplay={String(autoplay)}
      data-player-lazy={String(lazy)}
      data-player-muted="true"
      data-player-status="idle"
      data-player-activated="false"
    >
      <video
        class="hls-background_video"
        poster={poster}
        preload="none"
        playsinline
        muted
        aria-hidden="true"
      />
      {controls && (
        <div class="hls-background_controls">
          <HlsButton control="playpause" label="Play video" />
        </div>
      )}
      <span class="hls-background_loading" role="status">
        Loading video…
      </span>
      <div class="hls-background_error" role="status">
        <span>Video unavailable.</span>
        <button type="button" data-player-control="retry">
          Retry video
        </button>
      </div>
      <noscript>
        <a class="hls-background_fallback" href={src}>
          Open video
        </a>
      </noscript>
    </div>
  </hls-background>
)}
<script>
  import { defineBehaviour } from "@/lib/motion/scope";
  import { setupHls } from "@/lib/media/hls";
  defineBehaviour("hls-background", (element, scope) => {
    const root = element.querySelector<HTMLElement>(
      "[data-hls-background-init]",
    );
    if (root) setupHls(root, scope, true);
  });
</script>
<style is:global>
  @layer components {
    .hls-background_wrap {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      isolation: isolate;
      overflow: hidden;
      border-radius: inherit;
      background: var(--dark-900);
      color: var(--light-100);
      pointer-events: none;
    }
    .hls-background_video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .hls-background_controls {
      display: none;
      position: absolute;
      inset-inline-end: var(--space-4);
      bottom: var(--space-4);
      pointer-events: auto;
    }
    .hls-background_loading,
    .hls-background_error {
      display: none;
      position: absolute;
      inset: 0;
      place-content: center;
      justify-items: center;
      gap: var(--space-3);
      background: color-mix(in srgb, var(--dark-900) 70%, transparent);
    }
    .hls-background_error button {
      pointer-events: auto;
      text-decoration: underline;
      cursor: pointer;
    }
    .hls-background_fallback {
      position: absolute;
      inset: auto auto var(--space-4) var(--space-4);
      pointer-events: auto;
    }
    .hls-background_wrap[data-player-enhanced] .hls-background_controls {
      display: block;
    }
    .hls-background_wrap[data-player-status="loading"] .hls-background_loading,
    .hls-background_wrap[data-player-status="error"] .hls-background_error {
      display: grid;
    }
  }
</style>
